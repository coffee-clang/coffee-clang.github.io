<!DOCTYPE html>
<html lang="{{ language }}">
<head>
  <meta charset="utf-8">
  <title>Cup of Coffee - A modern C toolchain manager</title>
  <meta name="keywords" content="C, C programming language, cup, coffee">
  <meta name="description" content="Tools and libraries for modern C development">
  <link rel="stylesheet" href="./normalize.css">
  <link rel="stylesheet" href="./brand.css">
  <link rel="stylesheet" href="./cup.css">
  <link rel="stylesheet" href="./mdbook.css">
  <link rel="icon" type="image/svg+xml" href="./logo.svg">
</head>
<body>

<!-- Menu bar with org navigation -->
<nav class="menu-bar" id="menu-bar">
  <a href="https://coffee-clang.github.io/">Home</a>
  <a href="https://coffee-clang.github.io/cup">Cup</a>
  <a href="https://coffee-clang.github.io/coffee">Coffee</a>
  <a href="https://coffee-clang.github.io/recipes/">Recipes</a>
  <a href="https://github.com/coffee-clang">GitHub</a>
</nav>

<div id="page-wrapper" class="page-wrapper">
  <div class="content">
    <main>
      {{{ content }}}
    </main>
    <hr class="xhr">

    <p id="help">
      Need help?<br>
      Please wait: the project is still pre-alpha!
    </p>
    <p id="about">
        Coffee is an open-source project inspired by <a
                                                           href="https://github.com/rust-lang/cargo">Cargo</a>
    </br>
      Cup is a <a href="https://coffee-clang.github.io/">Coffee</a> project
      inspired by <a href="https://rustup.rs">Rustup</a>
        </br>
        Recipes is a <a href="https://coffee-clang.github.io/">Coffee</a> project
        inspired by <a href="https://crates.io">Crates</a> and <a href="https://conda-forge.org/">C Conda-forge</a>
    </p>

    <script>
    document.addEventListener("DOMContentLoaded", function() {
      var btn = document.getElementById("copy-button-cup");
      var pre = document.querySelector(".cup-command");
      var status = document.getElementById("copy-status-cup");
      if (btn && pre) {
        btn.addEventListener("click", function() {
          navigator.clipboard.writeText(pre.textContent.trim()).then(function() {
            status.hidden = false;
            setTimeout(function() { status.hidden = true; }, 2000);
          });
        });
      }
    });
    </script>
  </div>
</div>

<script src="./book.js"></script>
</body>
</html>
